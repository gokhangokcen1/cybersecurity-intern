# Tarama noktasinin ekranda ve e-posta raporunda gorunecek adi
SCANNER_NAME=Turkiye
RESULTS_FILE=data/results.json

# Merkez (Turkiye) kurulumunda yurtdisi tarayiciyi birlestirmek icin
REMOTE_SCANNER_URL=https://scanner.example.com
REMOTE_SCANNER_TOKEN=degistirilecek-uzun-rastgele-token

# Sadece yurtdisi tarayicida: merkezden gelen dahili API cagrilarini korur
SCANNER_API_TOKEN=degistirilecek-uzun-rastgele-token

# SMTP raporlari icin (istege bagli)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=scanner@example.com
SMTP_PASSWORD=uygulama-sifresi
SMTP_FROM=scanner@example.com
